name: Build Music Player APK
on:
  workflow_dispatch:
  push:
    branches: ["main", "master"]
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        
      - name: Create Android project
        shell: bash
        run: |
          set -e
          mkdir -p .
          
          # Gradle Settings
          cat << 'EOF' > settings.gradle
          pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
          dependencyResolutionManagement { repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS); repositories { google(); mavenCentral() } }
          rootProject.name='MusicPlayer'; include ':app'
          EOF

          cat << 'EOF' > build.gradle
          plugins { id 'com.android.application' version '8.6.1' apply false }
          EOF

          cat << 'EOF' > gradle.properties
          org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
          android.useAndroidX=true
          android.nonTransitiveRClass=true
          EOF

          # App Build Config
          mkdir -p app
          cat << 'EOF' > app/build.gradle
          plugins { id 'com.android.application' }
          android { 
              namespace 'com.example.musicplayer'
              compileSdk 35
              defaultConfig { 
                  applicationId 'com.example.musicplayer'
                  minSdk 23
                  targetSdk 35
                  versionCode 1
                  versionName '1.0' 
              }
          }
          EOF

          # Android Manifest (Storage Permission Added)
          mkdir -p app/src/main
          cat << 'EOF' > app/src/main/AndroidManifest.xml
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
              <application android:theme="@style/AppTheme" android:label="Music Player" android:allowBackup="true" android:supportsRtl="true">
                  <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN"/>
                          <category android:name="android.intent.category.LAUNCHER"/>
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF

          # App Theme
          mkdir -p app/src/main/res/values
          cat << 'EOF' > app/src/main/res/values/styles.xml
          <resources>
              <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
                  <item name="android:colorPrimary">#4A00E0</item>
                  <item name="android:colorPrimaryDark">#1E1E24</item>
                  <item name="android:colorAccent">#8E2DE2</item>
              </style>
          </resources>
          EOF

          # Main Activity (Music Player UI and Logic)
          mkdir -p app/src/main/java/com/example/musicplayer
          cat << 'EOF' > app/src/main/java/com/example/musicplayer/MainActivity.java
          package com.example.musicplayer;
          
          import android.app.Activity;
          import android.content.Intent;
          import android.graphics.Color;
          import android.media.MediaPlayer;
          import android.net.Uri;
          import android.os.Bundle;
          import android.view.Gravity;
          import android.widget.Button;
          import android.widget.LinearLayout;
          import android.widget.TextView;
          import android.widget.Toast;

          public class MainActivity extends Activity {
              MediaPlayer player;
              TextView titleText;

              @Override
              public void onCreate(Bundle savedInstanceState) {
                  super.onCreate(savedInstanceState);
                  
                  // Main UI Layout
                  LinearLayout root = new LinearLayout(this);
                  root.setOrientation(LinearLayout.VERTICAL);
                  root.setGravity(Gravity.CENTER);
                  root.setBackgroundColor(Color.parseColor("#1E1E24")); // Dark background

                  titleText = new TextView(this);
                  titleText.setText("No Song Selected");
                  titleText.setTextColor(Color.WHITE);
                  titleText.setTextSize(22);
                  titleText.setGravity(Gravity.CENTER);
                  titleText.setPadding(0, 0, 0, 60);

                  // Button to pick a song from folder
                  Button pickBtn = new Button(this);
                  pickBtn.setText("Select Song from Folder");
                  pickBtn.setBackgroundColor(Color.parseColor("#8E2DE2"));
                  pickBtn.setTextColor(Color.WHITE);
                  pickBtn.setOnClickListener(v -> {
                      Intent intent = new Intent(Intent.ACTION_GET_CONTENT);
                      intent.setType("audio/*");
                      startActivityForResult(intent, 1);
                  });

                  // Play/Pause Button
                  Button playBtn = new Button(this);
                  playBtn.setText("Play / Pause");
                  playBtn.setBackgroundColor(Color.parseColor("#4A00E0"));
                  playBtn.setTextColor(Color.WHITE);
                  playBtn.setOnClickListener(v -> {
                      if (player != null) {
                          if (player.isPlaying()) {
                              player.pause();
                          } else {
                              player.start();
                          }
                      } else {
                          Toast.makeText(this, "Please select a song first!", Toast.LENGTH_SHORT).show();
                      }
                  });

                  // Add views with spacing
                  LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                          LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT);
                  params.setMargins(0, 20, 0, 20);

                  root.addView(titleText, params);
                  root.addView(pickBtn, params);
                  root.addView(playBtn, params);
                  setContentView(root);
              }

              @Override
              protected void onActivityResult(int requestCode, int resultCode, Intent data) {
                  if (requestCode == 1 && resultCode == RESULT_OK && data != null) {
                      Uri audioUri = data.getData();
                      try {
                          if (player != null) {
                              player.release();
                          }
                          player = MediaPlayer.create(this, audioUri);
                          player.start();
                          titleText.setText("Playing Your Song \uD83C\uDFB5");
                      } catch (Exception e) {
                          Toast.makeText(this, "Error playing the song", Toast.LENGTH_SHORT).show();
                      }
                  }
              }

              @Override
              protected void onDestroy() {
                  super.onDestroy();
                  if (player != null) player.release();
              }
          }
          EOF

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Build APK
        run: gradle --no-daemon :app:assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: MusicPlayer-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
